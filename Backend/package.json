{
  "name": "itbock.de-backend",
  "version": "1.0.0",
  "description": "The backend of the webpage",
  "main": "src/lambda.ts",
  "scripts": {
    "dev:ai": "npx ai-code-writer",
    "start": "npm-run-all --serial build start:local",
    "deploy": "npm-run-all --serial build deploy:aws",
    "build:tsc": "tsc",
    "build": "node scripts/build.js",
    "knowledge:index": "node scripts/knowledge-index.js",
    "start:local": "node scripts/local-server.js",
    "deploy:aws": "node scripts/deploy.js",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "author": "Endre Bock",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "*",
    "busboy": "*",
    "openai": "^7.30.0",
    "otplib": "*"
  },
  "devDependencies": {
    "@types/aws-lambda": "*",
    "@types/busboy": "^1.5.4",
    "@types/crypto-js": "*",
    "@types/node": "^24.19.1",
    "@types/otplib": "*",
    "npm-run-all": "*",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
