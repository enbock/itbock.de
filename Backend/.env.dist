# OpenAI API key. Project- and service-account-keys (sk-proj-…, sk-svcacct-…) are supported.
OPENAI_API_KEY=
S3_BUCKET_NAME=your_s3_bucket_name_here
S3_TOKEN_PATH=your_s3_token_path_here
S3_USER_DATA_PATH=your_s3_user_data_path_here
S3_SESSION_PATH=your_s3_session_path_here

# Deployment (npm run deploy)
DEPLOY_ARTIFACT_BUCKET=your_deploy_artifact_bucket_here
STACK_NAME=your_stack_name_here
STAGE_NAME=your_stage_name_here
DOMAIN_NAME=your_domain_name_here
