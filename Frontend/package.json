{
  "name": "ai-webpage-itbock.de",
  "version": "2.0.0",
  "scripts": {
    "start": "webpack serve --open --mode development --no-open --no-live-reload --no-hot --stats-error-details",
    "deploy": "npm-run-all --serial build build:swm:update deploy:clean deploy:copy",
    "build": "webpack --mode production",
    "deploy:clean": "aws s3 rm s3://www.itbock.de/ --recursive --exclude \"*\" --include \"bundle.*\"",
    "deploy:copy": "aws s3 sync build s3://www.itbock.de/",
    "build:swm:tsc": "tsc Application/ServiceWorkerManager.ts --module esnext --target esnext",
    "build:swm:compile": "npm run build:swm:tsc -- --moduleResolution node --outdir build",
    "build:swm:update": "node scripts/buildServiceWorker.js",
    "test": "node --import tsx --test \"**/*.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-polly": "*",
    "@types/node": "*",
    "copy-webpack-plugin": "*",
    "css-loader": "*",
    "dotenv": "*",
    "dotenv-webpack": "*",
    "html-webpack-plugin": "*",
    "npm-run-all": "*",
    "style-loader": "*",
    "ts-loader": "*",
    "typescript": "*",
    "webpack": "*",
    "webpack-cli": "*",
    "webpack-dev-server": "*"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
